{
  "name": "dsh-balance-quota",
  "version": "0.3.1",
  "description": "DeepSeek Harness plugin for secure provider balance and quota display",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "balance",
    "quota",
    "provider"
  ],
  "license": "MIT",
  "author": "kongshan-zhuyu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kongshan-zhuyu/dsh-balance-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/kongshan-zhuyu/dsh-balance-plugin/issues"
  },
  "homepage": "https://github.com/kongshan-zhuyu/dsh-balance-plugin#readme",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  }
}
